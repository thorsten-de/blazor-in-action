@using System.Threading.Tasks
@inherits TestContext
@code {
    private readonly Fixture _fixture = new();

    public FavoriteButtonTest()
    {
        this.AddBlazoredLocalStorage();


        this.Services.AddScoped<AppState>();
    }

    [Fact]
    public void RendersAddFavoriteButton_When_TrailsIsNotFavorited()
    {
        var testTrail = _fixture.Create<Trail>();

        var cut = Render(@<FavoriteButton Trail="testTrail" />);

        cut.MarkupMatches(
            @<button class:ignore title:regex="^Add">
                <i class="bi bi-heart"></i>
            </button>
        );
    }

    [Fact]
    public async Task RendersRemoveFavoriteButton_When_TrailsIsFavorited()
    {
        var testTrail = _fixture.Create<Trail>();

        var appState = this.Services.GetRequiredService<AppState>();
        await appState.FavoriteTrails.AddFavorite(testTrail);

        var cut = Render(@<FavoriteButton Trail="testTrail" />);

        cut.MarkupMatches(
            @<button class:ignore title:regex="^Remove">
                <i class="bi bi-heart-fill"></i>
            </button>
        );
    }

    [Fact]
    public void AddTrailToFavorites_When_TrailIsNotFavorite()
    {
        var testTrail = _fixture.Create<Trail>();
        var cut = Render(
            @<FavoriteButton Trail="testTrail" />
        );
        var button = cut.Find("button");

        button.Click();

        var appState = this.Services.GetRequiredService<AppState>();
        Assert.True(appState.FavoriteTrails.IsFavorite(testTrail));
    }

    [Fact]
    public async Task RemoveTrailFromFavorites_When_TrailIsFavorite()
    {
        var testTrail = _fixture.Create<Trail>();
        var appState = this.Services.GetRequiredService<AppState>();
        await appState.FavoriteTrails.AddFavorite(testTrail);
        var cut = Render(
            @<FavoriteButton Trail="testTrail" />
        );
        var button = cut.Find("button");

        button.Click();

        Assert.False(appState.FavoriteTrails.IsFavorite(testTrail));
    }
}