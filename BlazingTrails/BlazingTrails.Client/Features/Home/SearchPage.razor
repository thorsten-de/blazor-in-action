@page "/search/{searchTerm}"
@page "/search/{searchTerm}/maxLength/{maxLength:int}"
@inject HttpClient Http
@inject NavigationManager NavManager

<PageTitle>Search Trails - Blazing Trails</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a href="/">Home</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">Search</li>
    </ol>
</nav>

<h3 class="mt-5 mb-4">Search Results for "@SearchTerm"</h3>

<SearchFilter SearchTerm="@SearchTerm" />

@if (_searchResults is null)
{
    <p><em>Loading...</em></p>
}
else if (!_searchResults.Any())
{
    <p>No trails found matching "@SearchTerm". Please try a different search term.</p>
}
else
{
    <TrailDetails Trail="_selectedTrail" />
    <div class="grid">
        @foreach (var trail in _searchResults)
        {
            <TrailCard trail="trail" OnSelected="HandleTrailSelected" />
        }
    </div>
}

@code {
    private IEnumerable<Trail>? _searchResults;
    private IEnumerable<Trail> _cachedSearchResults = [];
    private Trail? _selectedTrail;

    [Parameter]
    public string SearchTerm { get; set; } = default!;

    [Parameter]
    public int? MaxLength { get; set; }


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var allTrails = await Http.GetFromJsonAsync<IEnumerable<Trail>>("trails/trail-data.json");
            _searchResults = allTrails.Where(TrailMatchesSearchTerm);
            _cachedSearchResults = _searchResults;
        }
        catch (HttpRequestException ex)
        {
            Console.Error.WriteLine($"There was a problem fetching the trail data: {ex.Message}");
        }
    }

    protected override void OnParametersSet()
    {
        _searchResults = MaxLength switch
        {
            null => _cachedSearchResults,
            int length => _cachedSearchResults.Where(x => x.Length <= length),
        };
    }



    private void HandleTrailSelected(Trail trail) =>
    _selectedTrail = trail;

    private bool TrailMatchesSearchTerm(Trail trail) =>
    trail.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) ||
    trail.Location.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase);
}