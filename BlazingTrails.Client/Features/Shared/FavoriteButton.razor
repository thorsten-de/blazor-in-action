@inject AppState AppState

@if (AppState.FavoriteTrails.IsFavorite(Trail))
{
    <button class="btn btn-outline-primary ml-1" title="Remove trail from favorites" 
        @onclick="@(() => AppState.FavoriteTrails.RemoveFavorite(Trail))">
        <i class="bi bi-heart-fill"></i>
    </button>
}
else 
{
    <button class="btn btn-outline-primary ml-1" title="Add trail to favorites"
        @onclick="@(() => AppState.FavoriteTrails.AddFavorite(Trail))">
        <i class="bi bi-heart"></i>
    </button>
}

@code {
    [Parameter, EditorRequired]
    public Trail Trail { get; set; } = default!;
}