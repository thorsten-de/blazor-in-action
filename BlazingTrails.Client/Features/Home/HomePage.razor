@page "/"
@inject IMediator Mediator
@inject NavigationManager NavManager

<PageTitle>Blazing Trails</PageTitle>

@if (_trails is null)
{
  <p><em>Loading...</em></p>
}
else
{
  <TrailDetails Trail="_selectedTrail" />
  <TrailSearch />

  @if (_trails.Any())
  {
    <div class="mb-4">
      <p class="font-italic text-center">
        <AuthorizeView>
          <Authorized>
            Do you have an awesome trail to share with us? <a href="add-trail">Add it here</a>.
          </Authorized>
          <NotAuthorized>
            Do you have an awesome trail to share with us? Please <a href="authentication/login">log in or sign up</a>.
          </NotAuthorized>
        </AuthorizeView>
      </p>
    </div>
    <ViewSwitcher Items="_trails" Context="trail">
      <GridTemplate>
        <TrailCard trail="trail" OnSelected="HandleTrailSelected" />
      </GridTemplate>
      <HeaderTemplate>
        <th>Name</th>
        <th>Location</th>
        <th>Length</th>
        <th>Time</th>
        <th></th>
      </HeaderTemplate>
      <RowTemplate>
        <th scope="col">@trail.Name</th>
        <td>@trail.Location</td>
        <td>@trail.Length km</td>
        <td>@trail.TimeFormatted</td>
        <td class="text-end">
          <button class="btn btn-primary" title="View" @onclick="@(() => HandleTrailSelected(trail))">
            <i class="bi bi-binoculars"></i>
          </button>
          <FavoriteButton Trail="trail"></FavoriteButton>
          <AuthorizeView>
            @if (context.User.IsEditorOf(trail))
            {
              <button class="btn btn-outline-secondary" title="Edit"
                      @onclick="@(() => NavManager.NavigateTo($"/edit-trail/{trail.Id}"))">
                <i class="bi bi-pencil"></i>
              </button>
            }
          </AuthorizeView>
        </td>
      </RowTemplate>
    </ViewSwitcher>
  }
  else
  {
    <div class="no-trails">
      <svg viewBox="0 0 16 16" class="bi bi-tree" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd"
              d="M8 0a.5.5 0 0 1 .416.223l3 4.5A.5.5 0 0 1 11 5.5h-.098l2.022 3.235a.5.5 0 0 1-.424.765h-.191l1.638 3.276a.5.5 0 0 1-.447.724h-11a.5.5 0 0 1-.447-.724L3.69 9.5H3.5a.5.5 0 0 1-.424-.765L5.098 5.5H5a.5.5 0 0 1-.416-.777l3-4.5A.5.5 0 0 1 8 0zM5.934 4.5H6a.5.5 0 0 1 .424.765L4.402 8.5H4.5a.5.5 0 0 1 .447.724L3.31 12.5h9.382l-1.638-3.276A.5.5 0 0 1 11.5 8.5h.098L9.576 5.265A.5.5 0 0 1 10 4.5h.066L8 1.401 5.934 4.5z" />
        <path d="M7 13.5h2V16H7v-2.5z" />
      </svg>
      <h3 class="text-muted font-weight-light">
        We currently don't know any trails, <a href="add-trail">why not add one?</a>
      </h3>
    </div>
  }

}

@code {
  private IEnumerable<Trail>? _trails;
  private Trail? _selectedTrail;

  public void HandleTrailSelected(Trail trail) =>
  _selectedTrail = trail;

  protected override async Task OnInitializedAsync()
  {
    try
    {
      var response = await Mediator.Send(new GetTrailsRequest());
      _trails = response.Trails.Select(Trail.FromRequest);
    }
    catch (HttpRequestException ex)
    {
      Console.Error.WriteLine($"There was a problem fetching the trail data: {ex.Message}");
    }
  }
}