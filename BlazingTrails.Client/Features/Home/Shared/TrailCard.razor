@inject NavigationManager Navmanager

<div class="card shadow" style="width: 18rem;">
    <img class="card-img-top" alt="@Trail.Name"
         src="@(!string.IsNullOrWhiteSpace(Trail.Image) ? $"images/{Trail.Image}" : "https://dummyimage.com/286x190.jpg?text=No+Image+For+Trail")">
    <div class="card-body">
        <h5 class="card-title">@Trail.Name</h5>
        <h6 class="card-subtitle mb-3 text-muted">
            <span class="bi bi-geo-alt-fill"></span>
            @Trail.Location
        </h6>
        <div class="d-flex justify-content-between">
            <span>
                <span class="bi bi-clock mr-2"></span>
                @Trail.TimeFormatted
            </span>
            <span>
                <span class="bi bi-infinity mr-2"></span>
                @Trail.Length km
            </span>
        </div>
        <button class="btn btn-outline-secondary float-end" title="Edit"
                @onclick="@(() => Navmanager.NavigateTo($"/edit-trail/{Trail.Id}"))">
            <i class="bi bi-pencil-square"></i>
        </button>
        <button class="btn btn-primary" title="View" @onclick="@(async () => await OnSelected.InvokeAsync(Trail))">
            <i class="bi bi-binoculars"></i>
        </button>


    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Trail Trail { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<Trail> OnSelected { get; set; }
}
