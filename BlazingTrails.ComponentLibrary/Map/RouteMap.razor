@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable

<div class="map-wrapper">
  <div class="controls">
    <button class="btn btn-secondary" @onclick="DeleteLastWaypoint" type="button" title="Delete the last waypoint">
      <i class="bi bi-trash"></i> Remove Last Waypoint
    </button>
  </div>
  <div style="height:@Height;width:@Width;" @ref="_map"></div>
</div>

@code {
  /// <summary>
  /// The reference for our RouteMap to pass into JS functions
  /// that call methods on our razor component.
  /// </summary>
  private DotNetObjectReference<RouteMap> _routeMapReference;
  private ElementReference _map;
  private IJSObjectReference? _routeMapModule;

  [Parameter] public string Height { get; set; } = "500px";
  [Parameter] public string Width { get; set; } = "1000px";

  [Parameter]
  public List<LatLong> Waypoints { get; set; } = [];

  /// <summary>
  /// Notifies that a waypoint is added
  /// </summary>
  [Parameter]
  public EventCallback<LatLong> OnWaypointAdded { get; set; }

  /// <summary>
  /// Notifies that a waypint is deleted
  /// </summary>
  [Parameter]
  public EventCallback<LatLong> OnWaypointDeleted { get; set; }

  /// <summary>
  /// We use OnAfterRenderAsync to load the routeMap module and capture
  /// a reference to it when we render our component for the first time.
  /// <para>
  /// We do it here because the DOM has to be in place to be operated
  /// from our js code. We load the js file on demand, that resides in
  /// the given path. Then, we can call initialized on the module via
  /// <c>InvokeVoidAsync</c>, which calls a js function without a return
  /// value.
  /// </para>
  /// </summary>
  /// <param name="firstRender"></param>
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _routeMapModule = await JS.InvokeAsync<IJSObjectReference>("import",
          "./_content/BlazingTrails.ComponentLibrary/Map/RouteMap.razor.js?v=1");

      // Create an object reference for our component
      _routeMapReference = DotNetObjectReference.Create(this);

      // Pass our components object reference to the js module, so it can call us back
      await _routeMapModule.InvokeVoidAsync("initialize", _map, _routeMapReference, Waypoints);

    }
  }

  /// <summary>
  /// When the Component gets destroyed, we dispose our reference
  /// to the js module.
  /// </summary>
  async ValueTask IAsyncDisposable.DisposeAsync()
  {
    if (_routeMapModule is not null)
      await _routeMapModule.DisposeAsync();
  }

  /// <summary>
  /// Deletes the last set waypoint from your Route
  /// </summary>
  public async Task DeleteLastWaypoint()
  {
    if (_routeMapModule is null) return;

    var waypoint = await _routeMapModule.InvokeAsync<LatLong>("deleteLastWaypoint", _map);
    await OnWaypointDeleted.InvokeAsync(waypoint);
  }

  /// <summary>
  /// This method is called from our JS module when a new Marker is dropped on the map.
  /// We are going to show this information for now, but will include a new waypoint
  /// to our route in the future.
  /// </summary>
  [JSInvokable]
  public async Task WaypointAdded(decimal latitude, decimal longitude)
    => await OnWaypointAdded.InvokeAsync(new LatLong(latitude, longitude));

  /// <summary>
  /// Cleans up the object reference when our component is destroyed.
  /// </summary>
  void IDisposable.Dispose()
  {
    _routeMapReference?.Dispose();
  }
}